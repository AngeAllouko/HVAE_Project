<%@ page import="com.hvae.web.Html" %>
<%
    String ctx = request.getContextPath();
    String pageTitle = (String) request.getAttribute("pageTitle");
    String nav = (String) request.getAttribute("nav");
    if (nav == null) nav = "";
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= Html.esc(pageTitle == null ? "HVAE" : pageTitle) %> - HVAE</title>
<link rel="stylesheet" href="<%= ctx %>/css/style.css">
</head>
<body>
<div class="app">
<aside class="sidebar">
  <a class="logo" href="<%= ctx %>/home"><span class="logo-mark" aria-hidden="true"></span>HVAE</a>
  <a class="new-btn" href="<%= ctx %>/home">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
    New evaluation</a>

  <div class="grp">Features</div>
  <nav class="menu" aria-label="Main">
    <a class="item <%= nav.equals("home") ? "active" : "" %>" href="<%= ctx %>/home">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.7A8 8 0 1 1 21 12z"/></svg>Evaluate</a>
    <a class="item <%= nav.equals("history") ? "active" : "" %>" href="<%= ctx %>/history">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>History</a>
    <a class="item <%= nav.equals("rules") ? "active" : "" %>" href="<%= ctx %>/rules">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h14v16H5zM9 9h6M9 13h6M9 17h3"/></svg>Rules</a>
    <a class="item <%= nav.equals("testing") ? "active" : "" %>" href="<%= ctx %>/testing">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Testing</a>
  </nav>

  <div class="grp">Values</div>
  <nav class="menu" aria-label="Values">
    <a class="item" href="<%= ctx %>/rules#safety"><i class="dot v-safety"></i>Safety</a>
    <a class="item" href="<%= ctx %>/rules#privacy"><i class="dot v-privacy"></i>Privacy</a>
    <a class="item" href="<%= ctx %>/rules#fairness"><i class="dot v-fairness"></i>Fairness</a>
    <a class="item" href="<%= ctx %>/rules#honesty"><i class="dot v-honesty"></i>Honesty</a>
    <a class="item" href="<%= ctx %>/rules#autonomy"><i class="dot v-autonomy"></i>Autonomy</a>
  </nav>

  <div class="side-card">
    <strong>No AI model inside</strong>
    <p>Every result comes from documented rules you can read and test.</p>
    <a class="ghost" href="<%= ctx %>/rules">View rule catalogue</a>
  </div>
</aside>

<section class="content">
  <div class="topbar">
    <span class="pill">Rule-based engine</span>
    <span class="spacer"></span>
    <a class="pill link" href="<%= ctx %>/testing">Testing and results</a>
  </div>
  <main class="page <%= nav.equals("home") ? "is-home" : "" %>">
